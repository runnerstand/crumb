<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".AddFragment"
    tools:theme="@style/Theme.Crumb">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_ingredients_title"
        android:textAppearance="?attr/textAppearanceHeadlineLarge" />

    <Button
        android:id="@+id/create_recipe_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/create_recipe" />

    <Button
        android:id="@+id/create_community_post_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="@string/create_community_post_later" />

    <EditText
        android:id="@+id/ingredient_search_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/search_ingredients_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/selected_ingredients_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/selected_ingredients_title"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/selected_ingredients_chip_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleLine="false" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/selected_ingredients_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/selected_ingredients_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/loading_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ingredients_loading"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ingredients_empty"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/retry_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/retry"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ingredient_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:visibility="gone"
        tools:itemCount="6"
        tools:listitem="@layout/item_ingredient"
        tools:visibility="visible" />
</LinearLayout>
