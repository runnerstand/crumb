<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:fillViewport="true"
    tools:theme="@style/Theme.Crumb">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- 1. FULL-SCREEN IMAGE COVER HEADER -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/recipe_image_card"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/recipe_post_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/recipe_placeholder"
                    android:contentDescription="Recipe Image" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Gradient overlay for button readability -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_circle_translucent"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back_button"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_circle_translucent"
                app:icon="@drawable/ic_arrow_back"
                app:iconSize="20dp"
                app:iconTint="@color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bookmark_button"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_circle_translucent"
                android:contentDescription="@string/save_this_recipe"
                app:icon="@drawable/ic_bookmark_border"
                app:iconSize="20dp"
                app:iconTint="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/detail_status_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/detail_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dark_brown"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="@string/recipe_not_found" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_status_back_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/go_back"
                android:textColor="@color/primary_orange"
                app:cornerRadius="@dimen/button_radius"
                app:strokeColor="@color/primary_orange" />
        </LinearLayout>

        <!-- 2. CONTENT CONTAINER -->
        <LinearLayout
            android:id="@+id/recipe_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/recipe_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dark_brown"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                tools:text="Spaghetti with Fresh Basil &amp; Cherry Tomatoes" />

            <!-- Creator Information -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/creator_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/avatar_placeholder"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/creator_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dark_brown"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Chef Isabella" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/creator_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted_brown"
                        android:textSize="12sp"
                        tools:text="Culinary Artist &amp; Pasta Lover" />
                </LinearLayout>

            </LinearLayout>

            <!-- Sharing Caption -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/sharing_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_muted_brown"
                android:textSize="14sp"
                android:fontFamily="sans-serif-light"
                android:visibility="gone"
                tools:text="This is my go-to quick pasta recipe! It's fresh, fragrant, and takes under 20 minutes to whip up. Perfect for a cozy weeknight dinner! 🍝✨" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color"
                android:layout_marginTop="16dp" />

            <!-- Metadata Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center">

                <!-- Rating -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/primary_orange"
                        android:contentDescription="Star Rating" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/recipe_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_dark_brown"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="@string/no_ratings_yet" />
                </LinearLayout>

                <!-- Vertical Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="@color/divider_color" />

                <!-- Cooking Time -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_schedule"
                        app:tint="@color/accent_green"
                        android:contentDescription="Cooking Time" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/cooking_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_dark_brown"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="20 mins" />
                </LinearLayout>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color"
                android:layout_marginTop="16dp" />

            <!-- Serving Selector & Measurement Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">

                <!-- Serving Selector Card -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_rounded_field"
                    android:padding="2dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/decrease_servings_button"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:icon="@drawable/ic_remove_circle"
                        app:iconSize="20dp"
                        app:iconTint="@color/primary_orange" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/serving_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/text_dark_brown"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/increase_servings_button"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:icon="@drawable/ic_add_circle"
                        app:iconSize="20dp"
                        app:iconTint="@color/primary_orange" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Metric/US Toggle Group -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/measurement_toggle_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:checkedButton="@id/metric_toggle">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/metric_toggle"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="Metric"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/us_toggle"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="US"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <!-- 3. INGREDIENTS -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Ingredients"
                android:textColor="@color/text_dark_brown"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ingredients_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <!-- 4. DIRECTIONS -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Directions"
                android:textColor="@color/text_dark_brown"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/directions_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <!-- 5. COMMENTS PREVIEW -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/comments_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textColor="@color/text_dark_brown"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Comments (2)" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/comments_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_muted_brown"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="No comments yet. Be the first to comment."
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/comments_retry_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/retry"
                android:visibility="gone"
                app:cornerRadius="@dimen/button_radius" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/comments_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_community_comment" />

            <LinearLayout
                android:id="@+id/comment_rating_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/comment_rating_star_1"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@string/rating_star_1"
                        app:icon="@drawable/ic_star"
                        app:iconTint="@color/text_muted_brown" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/comment_rating_star_2"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@string/rating_star_2"
                        app:icon="@drawable/ic_star"
                        app:iconTint="@color/text_muted_brown" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/comment_rating_star_3"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@string/rating_star_3"
                        app:icon="@drawable/ic_star"
                        app:iconTint="@color/text_muted_brown" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/comment_rating_star_4"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@string/rating_star_4"
                        app:icon="@drawable/ic_star"
                        app:iconTint="@color/text_muted_brown" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/comment_rating_star_5"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@string/rating_star_5"
                        app:icon="@drawable/ic_star"
                        app:iconTint="@color/text_muted_brown" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_rounded_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <EditText
                        android:id="@+id/comment_input"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Add a comment..."
                        android:importantForAutofill="no"
                        android:inputType="textShortMessage"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_dark_brown"
                        android:textColorHint="@color/text_muted_brown"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/send_comment_button"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:icon="@drawable/ic_send"
                        app:iconSize="18dp"
                        app:iconTint="@color/primary_orange" />
                </LinearLayout>
            </LinearLayout>

            <!-- 6. BOTTOM RECIPE ACTION BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_recipe_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="28dp"
                android:contentDescription="@string/save_this_recipe"
                android:text="@string/save_this_recipe"
                app:cornerRadius="@dimen/button_radius"
                android:textColor="@color/white"
                android:backgroundTint="@color/primary_orange" />

            <LinearLayout
                android:id="@+id/owner_recipe_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/edit_recipe_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:contentDescription="@string/edit_recipe"
                    android:text="@string/edit_recipe"
                    android:textColor="@color/primary_orange"
                    app:cornerRadius="@dimen/button_radius"
                    app:strokeColor="@color/primary_orange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/delete_recipe_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:layout_weight="1"
                    android:contentDescription="@string/delete_recipe"
                    android:text="@string/delete_recipe"
                    android:textColor="@color/error_red"
                    app:cornerRadius="@dimen/button_radius" />
            </LinearLayout>

            <!-- 7. RECOMMENDATIONS -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="You might also like"
                android:textColor="@color/text_dark_brown"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recommendations_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_recipe_recommendation" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/recommendations_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/recommendations_empty"
                android:textColor="@color/text_muted_brown"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
