<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:fillViewport="true"
    tools:theme="@style/Theme.Crumb">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_welcome_title"
            android:textColor="@color/text_dark_brown"
            android:textSize="28sp"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/home_welcome_subtitle"
            android:textColor="@color/text_muted_brown"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/home_search_field"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_large"
            android:background="@drawable/bg_search_field"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:drawableTint="@color/text_muted_brown"
            android:focusable="false"
            android:hint="@string/home_search_hint"
            android:importantForAutofill="no"
            android:inputType="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColorHint="@color/text_muted_brown"
            android:textSize="15sp"
            tools:ignore="TextFieldTextFields" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_section"
            android:text="@string/home_section_featured"
            android:textColor="@color/text_dark_brown"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/home_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="@color/text_muted_brown"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="@string/recipes_loading"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_retry_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/retry"
            android:textColor="@color/primary_orange"
            android:visibility="gone"
            app:cornerRadius="@dimen/button_radius"
            app:strokeColor="@color/primary_orange"
            tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/featured_recipe_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardUseCompatPadding="true"
            app:strokeColor="@color/divider_color"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/featured_recipe_image"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:contentDescription="@string/recipe_image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/recipe_placeholder" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/featured_recipe_creator_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dark_brown"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Local User" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/featured_recipe_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:textColor="@color/text_dark_brown"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Recipe title" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/featured_recipe_cooking_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_muted_brown"
                        android:textSize="14sp"
                        tools:text="20 minutes" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/recent_recipes_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/home_section_trending"
            android:textColor="@color/text_dark_brown"
            android:textSize="18sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/recent_recipes_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/recent_recipes_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/home_no_recent_recipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/home_no_recent_recipes"
            android:textColor="@color/text_muted_brown"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/community_posts_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/home_section_community"
            android:textColor="@color/text_dark_brown"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/community_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="@color/text_muted_brown"
            android:textSize="14sp"
            tools:text="@string/community_posts_loading" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/community_retry_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/retry"
            android:textColor="@color/primary_orange"
            android:visibility="gone"
            app:cornerRadius="@dimen/button_radius"
            app:strokeColor="@color/primary_orange"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/community_posts_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginBottom="@dimen/spacing_large"
            android:nestedScrollingEnabled="false"
            android:visibility="gone"
            tools:itemCount="2"
            tools:listitem="@layout/item_community_post"
            tools:visibility="visible" />
    </LinearLayout>
</ScrollView>
