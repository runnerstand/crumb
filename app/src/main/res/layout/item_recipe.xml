<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_margin_bottom"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardUseCompatPadding="true"
    app:cardElevation="2dp"
    app:strokeColor="@color/divider_color"
    app:strokeWidth="1dp"
    tools:theme="@style/Theme.Crumb">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/recipe_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dark_brown"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Recipe title" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/recipe_cooking_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_muted_brown"
            android:textSize="14sp"
            tools:text="20 minutes" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/recipe_ingredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/accent_green"
            android:textSize="14sp"
            tools:text="egg, tomato, rice" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/view_recipe_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="@string/view"
                app:cornerRadius="@dimen/button_radius"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/edit_recipe_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:text="@string/edit"
                app:cornerRadius="@dimen/button_radius"
                app:strokeColor="@color/primary_orange"
                android:textColor="@color/primary_orange"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/delete_recipe_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:text="@string/delete"
                android:textColor="@color/error_red"
                app:cornerRadius="@dimen/button_radius"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
