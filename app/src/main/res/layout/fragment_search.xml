<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding"
    tools:context=".SearchFragment"
    tools:theme="@style/Theme.Crumb">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_back_button"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/search_back_content_description"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/text_dark_brown" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1"
            android:text="@string/search_title"
            android:textColor="@color/text_dark_brown"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/search_query_edit_text"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/spacing_large"
        android:background="@drawable/bg_search_field"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:drawableTint="@color/text_muted_brown"
        android:hint="@string/search_recipes_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_dark_brown"
        android:textColorHint="@color/text_muted_brown"
        android:textSize="15sp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/search_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:textColor="@color/text_muted_brown"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="@string/recommendations_loading"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/search_retry_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="@string/retry"
        android:textColor="@color/primary_orange"
        android:visibility="gone"
        app:cornerRadius="@dimen/button_radius"
        app:strokeColor="@color/primary_orange"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_results_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_large"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="16dp"
        android:visibility="gone"
        tools:itemCount="3"
        tools:listitem="@layout/item_community_post"
        tools:visibility="visible" />
</LinearLayout>
