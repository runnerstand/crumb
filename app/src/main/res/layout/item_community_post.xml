<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/community_post_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_margin_bottom"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardUseCompatPadding="true"
    app:cardElevation="2dp"
    app:strokeColor="@color/divider_color"
    app:strokeWidth="1dp"
    tools:theme="@style/Theme.Crumb">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <ImageView
            android:id="@+id/post_recipe_image"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:contentDescription="@string/recipe_image"
            android:scaleType="centerCrop"
            android:src="@drawable/recipe_placeholder"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/avatar_placeholder" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/post_creator_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:textColor="@color/text_dark_brown"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Local User" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/post_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:textColor="@color/text_dark_brown"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Pantry dinner" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/post_ingredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="@color/accent_green"
            android:textSize="14sp"
            tools:text="egg, tomato, rice" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/post_rating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/no_ratings_yet"
            android:textColor="@color/text_muted_brown"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/post_cooking_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="@color/text_muted_brown"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="20 minutes"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/post_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="@color/text_muted_brown"
            android:textSize="14sp"
            tools:text="Simple pantry dinner." />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/post_tap_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/tap_for_recipe_details"
            android:textColor="@color/primary_orange"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/post_actions_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/view_recipe_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="@string/view"
                android:textSize="13sp"
                android:visibility="gone"
                app:cornerRadius="@dimen/button_radius"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/comments_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="@string/comments"
                android:textSize="13sp"
                app:cornerRadius="@dimen/button_radius" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/edit_post_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:text="@string/edit"
                android:textColor="@color/primary_orange"
                android:textSize="13sp"
                app:cornerRadius="@dimen/button_radius"
                app:strokeColor="@color/primary_orange" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/delete_post_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:text="@string/delete"
                android:textColor="@color/error_red"
                android:textSize="13sp"
                app:cornerRadius="@dimen/button_radius" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
