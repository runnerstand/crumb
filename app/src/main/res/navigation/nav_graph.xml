<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.crumb.HomeFragment"
        android:label="@string/home_title"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.crumb.SearchFragment"
        android:label="@string/search_title"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/addFragment"
        android:name="com.example.crumb.AddFragment"
        android:label="@string/add_title"
        tools:layout="@layout/fragment_add" />

    <fragment
        android:id="@+id/savedFragment"
        android:name="com.example.crumb.SavedFragment"
        android:label="@string/saved_title"
        tools:layout="@layout/fragment_saved" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.crumb.ProfileFragment"
        android:label="@string/profile_title"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/recipePostDetailFragment"
        android:name="com.example.crumb.RecipePostDetailFragment"
        android:label="Recipe Details"
        tools:layout="@layout/fragment_recipe_post_detail">
        <argument
            android:name="postId"
            app:argType="integer"
            android:defaultValue="-1" />
        <argument
            android:name="recipeId"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>

    <fragment
        android:id="@+id/editRecipeFragment"
        android:name="com.example.crumb.EditRecipeFragment"
        android:label="@string/edit_recipe"
        tools:layout="@layout/fragment_add">
        <argument
            android:name="recipeId"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>
</navigation>
